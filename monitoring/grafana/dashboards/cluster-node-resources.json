{
  "uid": "cluster-node-resources",
  "title": "Cluster Node CPU, HugePages & SPDK Overhead",
  "tags": ["kubernetes", "node-exporter", "hugepages", "spdk"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Ready Kubernetes Nodes",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum(kube_node_status_condition{condition=\"Ready\",status=\"true\"}) or vector(0)"}]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Pre-Allocated 2MiB HugePages (Total / Free)",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "sum(node_memory_HugePages_Total) or vector(0)", "legendFormat": "total"},
        {"refId": "B", "expr": "sum(node_memory_HugePages_Free) or vector(0)", "legendFormat": "free"}
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Running Pods Across Cluster",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "count(kube_pod_status_phase{phase=\"Running\"} == 1) or vector(0)"}]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Pending / Non-Ready Pods",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "count(kube_pod_status_phase{phase=~\"Pending|Failed|Unknown\"} == 1) or vector(0)"}]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Host CPU Utilization % & SPDK io-engine Pinned Core Load",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))", "legendFormat": "host cpu% {{instance}}"},
        {"refId": "B", "expr": "sum by (node, pod) (rate(container_cpu_usage_seconds_total{namespace=\"openebs\",container=\"io-engine\"}[5m]))", "legendFormat": "spdk cores {{node}}/{{pod}}"}
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Node Memory Available vs Total Bytes",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "bytes"}},
      "targets": [
        {"refId": "A", "expr": "node_memory_MemAvailable_bytes", "legendFormat": "available {{instance}}"},
        {"refId": "B", "expr": "node_memory_MemTotal_bytes", "legendFormat": "total {{instance}}"}
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Physical Block Device Read / Write Throughput",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "Bps"}},
      "targets": [
        {"refId": "A", "expr": "sum by (instance, device) (rate(node_disk_read_bytes_total[5m]))", "legendFormat": "read {{instance}}:{{device}}"},
        {"refId": "B", "expr": "sum by (instance, device) (rate(node_disk_written_bytes_total[5m]))", "legendFormat": "write {{instance}}:{{device}}"}
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Node Network RX / TX Throughput (Non-Loopback)",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "Bps"}},
      "targets": [
        {"refId": "A", "expr": "sum by (instance, device) (rate(node_network_receive_bytes_total{device!=\"lo\"}[5m]))", "legendFormat": "rx {{instance}}:{{device}}"},
        {"refId": "B", "expr": "sum by (instance, device) (rate(node_network_transmit_bytes_total{device!=\"lo\"}[5m]))", "legendFormat": "tx {{instance}}:{{device}}"}
      ]
    }
  ]
}

