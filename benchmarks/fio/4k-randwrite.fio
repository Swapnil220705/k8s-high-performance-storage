# Versioned FIO Job Profile: 4 KiB Random Write (Durable Replication Latency)
# Project: Deploy High-Performance Storage for Kubernetes (SWFW_5S_08)
# Usage: fio --filename=<VERIFIED_TARGET_PATH> --output-format=json benchmarks/fio/4k-randwrite.fio
[global]
ioengine=libaio
direct=1
time_based=1
size=2G
ramp_time=30
runtime=120
group_reporting=1
randrepeat=0
norandommap=1
refill_buffers=1
clat_percentiles=1
percentile_list=50:95:99:99.9

[randwrite-4k]
description=4 KiB aligned random write synchronous replication latency and IOPS benchmark
rw=randwrite
bs=4k
iodepth=32
numjobs=1

