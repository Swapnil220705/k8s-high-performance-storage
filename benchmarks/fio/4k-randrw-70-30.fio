# Versioned FIO Job Profile: 4 KiB Mixed 70% Read / 30% Write (OLTP Profile)
# Project: Deploy High-Performance Storage for Kubernetes (SWFW_5S_08)
# Usage: fio --filename=<VERIFIED_TARGET_PATH> --output-format=json benchmarks/fio/4k-randrw-70-30.fio
[global]
ioengine=libaio
direct=1
time_based=1
size=2G
ramp_time=30
runtime=120
group_reporting=1
randrepeat=0
norandommap=1
refill_buffers=1
clat_percentiles=1
percentile_list=50:95:99:99.9

[randrw-4k-70-30]
description=4 KiB 70/30 mixed random read/write concurrent virtualized workload
rw=randrw
rwmixread=70
bs=4k
iodepth=16
numjobs=2

