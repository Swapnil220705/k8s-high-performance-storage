# Versioned FIO Job Profile: 1 MiB Sequential Read/Write Bandwidth Ceiling
# Project: Deploy High-Performance Storage for Kubernetes (SWFW_5S_08)
# Usage: fio --filename=<VERIFIED_TARGET_PATH> --output-format=json benchmarks/fio/1m-bandwidth.fio
[global]
ioengine=libaio
direct=1
time_based=1
size=4G
ramp_time=20
runtime=90
group_reporting=1
refill_buffers=1
clat_percentiles=1
percentile_list=50:95:99:99.9
stonewall

[seqread-1m]
description=1 MiB sequential read network/fabric bandwidth ceiling
rw=read
bs=1m
iodepth=8
numjobs=2

[seqwrite-1m]
description=1 MiB sequential write network/fabric replication bandwidth ceiling
rw=write
bs=1m
iodepth=8
numjobs=2

